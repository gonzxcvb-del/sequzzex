local drawings = {}

-- Авто-очистка при выходе игрока
Players.PlayerRemoving:Connect(function(p)
    if drawings[p] then
        pcall(function() drawings[p]:Remove() end)
        drawings[p] = nil
    end
end)

RunService.RenderStepped:Connect(function()
    pcall(function()
        -- 1. Chams / Boxes
        for _, p in ipairs(Players:GetPlayers()) do
            local drawObj = drawings[p]
            if not drawObj and Drawing then
                local box = Drawing.new("Square")
                box.Visible = false
                box.Color = Color3.fromRGB(255, 50, 50)
                box.Thickness = 1.5
                box.Filled = false
                drawings[p] = box
                drawObj = box
            end

            if drawObj then
                if p ~= LocalPlayer and p.Character and chamsActive then
                    local root = p.Character:FindFirstChild("HumanoidRootPart")
                    local hum = p.Character:FindFirstChildOfClass("Humanoid")
                    
                    if root and hum and hum.Health > 0 then
                        local pos, onScreen = Camera:WorldToViewportPoint(root.Position)
                        if onScreen then
                            local head = p.Character:FindFirstChild("Head") or root
                            local headPos = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
                            local legPos = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0))
                            
                            local height = math.abs(headPos.Y - legPos.Y)
                            local width = height * 0.55
                            
                            drawObj.Size = Vector2.new(width, height)
                            drawObj.Position = Vector2.new(pos.X - width/2, pos.Y - height/2)
                            drawObj.Visible = true
                        else
                            drawObj.Visible = false
                        end
                    else
                        drawObj.Visible = false
                    end
                else
                    drawObj.Visible = false
                end
            end
        end

        -- 2. Aimbot
        local targetCF = nil
        if aimActive and Camera and LocalPlayer.Character then
            local localRoot = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if localRoot then
                local closestHead = nil
                local shortestDist = math.huge

                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character then
                        local head = p.Character:FindFirstChild("Head")
                        local hum = p.Character:FindFirstChildOfClass("Humanoid")
                        
                        if head and hum and hum.Health > 0 then
                            local distance = (localRoot.Position - head.Position).Magnitude
                            if distance < shortestDist then
                                shortestDist = distance
                                closestHead = head.Position
                            end
                        end
                    end
                end

                if closestHead then
                    targetCF = CFrame.new(Camera.CFrame.Position, closestHead)
                    Camera.CFrame = targetCF
                end
            end
        end

        -- 3. Stretch
        if Camera and stretchActive then
            local baseCF = targetCF or Camera.CFrame
            Camera.CFrame = baseCF * CFrame.new(0, 0, 0, 1, 0, 0, 0, stretchValue, 0, 0, 0, 1)
        end
    end)
end)
