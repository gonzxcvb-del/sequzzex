local function createToggle(text, callback)
    local Frame = Instance.new("Frame")
    Frame.Size = UDim2.new(1, 0, 0, 38)
    Frame.BackgroundColor3 = Color3.fromRGB(22, 22, 30)
    Frame.BorderSizePixel = 0
    Frame.Parent = Container
    
    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 6)
    Corner.Parent = Frame
    
    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(0.7, 0, 1, 0)
    Label.Position = UDim2.new(0, 10, 0, 0)
    Label.BackgroundTransparency = 1
    Label.Text = text
    Label.TextColor3 = Color3.fromRGB(220, 220, 230)
    Label.TextSize, Label.Font = 11, Enum.Font.Code
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = Frame
    
    local SwitchBg = Instance.new("Frame")
    SwitchBg.Size = UDim2.new(0, 44, 0, 22)
    SwitchBg.Position = UDim2.new(1, -48, 0.5, -11)
    SwitchBg.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    SwitchBg.Parent = Frame
    
    local SCorner = Instance.new("UICorner")
    SCorner.CornerRadius = UDim.new(1, 0)
    SCorner.Parent = SwitchBg
    
    local Circle = Instance.new("Frame")
    Circle.Size = UDim2.new(0, 16, 0, 16)
    Circle.Position = UDim2.new(0, 3, 0.5, -8)
    Circle.BackgroundColor3 = Color3.fromRGB(150, 150, 170)
    Circle.Parent = SwitchBg
    
    local CCorn = Instance.new("UICorner")
    CCorn.CornerRadius = UDim.new(1, 0)
    CCorn.Parent = Circle
    
    local active = false
    
    local function setVisual(st)
        active = st
        if active then
            SwitchBg.BackgroundColor3 = Color3.fromRGB(0, 191, 255)
            Circle.Position = UDim2.new(1, -19, 0.5, -8)
            Circle.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
        else
            SwitchBg.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
            Circle.Position = UDim2.new(0, 3, 0.5, -8)
            Circle.BackgroundColor3 = Color3.fromRGB(150, 150, 170)
        end
        pcall(function() callback(active) end)
    end

    Frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            setVisual(not active)
        end
    end)
end

local function createSlider(text, min, max, default, callback)
    local Frame = Instance.new("Frame")
    Frame.Size = UDim2.new(1, 0, 0, 48)
    Frame.BackgroundColor3 = Color3.fromRGB(22, 22, 30)
    Frame.BorderSizePixel = 0
    Frame.Parent = Container
    
    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 6)
    Corner.Parent = Frame
    
    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(1, -20, 0, 18)
    Label.Position = UDim2.new(0, 10, 0, 4)
    Label.BackgroundTransparency = 1
    Label.Text = text .. ": " .. string.format("%.2f", default)
    Label.TextColor3 = Color3.fromRGB(220, 220, 230)
    Label.TextSize, Label.Font = 11, Enum.Font.Code
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = Frame
    
    local SliderBar = Instance.new("Frame")
    SliderBar.Size = UDim2.new(1, -20, 0, 12)
    SliderBar.Position = UDim2.new(0, 10, 0, 28)
    SliderBar.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    SliderBar.BorderSizePixel = 0
    SliderBar.Parent = Frame
    
    local SBarCorner = Instance.new("UICorner")
    SBarCorner.CornerRadius = UDim.new(1, 0)
    SBarCorner.Parent = SliderBar
    
    local SliderFill = Instance.new("Frame")
    SliderFill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
    SliderFill.BackgroundColor3 = Color3.fromRGB(0, 191, 255)
    SliderFill.BorderSizePixel = 0
    SliderFill.Parent = SliderBar
    
    local SFillCorner = Instance.new("UICorner")
    SFillCorner.CornerRadius = UDim.new(1, 0)
    SFillCorner.Parent = SliderFill

    local dragging = false
    
    local function updateInput(input)
        local sizeX = math.max(SliderBar.AbsoluteSize.X, 1)
        local pos = math.clamp((input.Position.X - SliderBar.AbsolutePosition.X) / sizeX, 0, 1)
        SliderFill.Size = UDim2.new(pos, 0, 1, 0)
        local val = min + (max - min) * pos
        Label.Text = text .. ": " .. string.format("%.2f", val)
        callback(val)
    end
    
    SliderBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            updateInput(input)
        end
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            updateInput(input)
        end
    end)
end

